# nanopb field options for the C++ lite client (fields lite actually touches get
# fixed-size storage; everything else stays callback-based and is skipped).
wagterm.ptyhost.Create.id            max_size:128
wagterm.ptyhost.Create.creation_ticket max_size:33
wagterm.ptyhost.PrepareCreate.id     max_size:128
wagterm.ptyhost.CreationRef.id       max_size:128
wagterm.ptyhost.CreationRef.ticket   max_size:33
wagterm.ptyhost.CreationReply.id     max_size:128
wagterm.ptyhost.CreationReply.ticket max_size:33
wagterm.ptyhost.Create.app           max_size:260
wagterm.ptyhost.Create.cwd           max_size:260
wagterm.ptyhost.Create.args          max_count:16
wagterm.ptyhost.Create.args          max_size:2048
wagterm.ptyhost.Attach.id            max_size:128
wagterm.ptyhost.Attach.creation_ticket max_size:33
wagterm.ptyhost.SessionRef.id        max_size:128
wagterm.ptyhost.SessionRef.creation_ticket max_size:33
wagterm.ptyhost.Resize.id            max_size:128
wagterm.ptyhost.Resize.creation_ticket max_size:33
wagterm.ptyhost.Reply.error          max_size:256
wagterm.ptyhost.HelloReply.protocol  int_size:IS_32
wagterm.ptyhost.CreateReply.id       max_size:128
wagterm.ptyhost.CreateReply.creation_ticket max_size:33
wagterm.ptyhost.AttachReply.pipe     max_size:128
wagterm.ptyhost.AttachReply.modes    max_size:1024
wagterm.ptyhost.AttachReply.creation_ticket max_size:33
# list: lite reads the host's live session ids at startup to ADOPT sessions that outlived a killed
# UI (the pty-host survives the UI by design). 64 is far past any realistic window's session count.
wagterm.ptyhost.ListReply.sessions   max_count:64
# Only id/has_exited/attached get storage — the three fields adoption decides on. `title` must NOT:
# nanopb fails the WHOLE ListReply decode on string overflow, and a title is whatever OSC 0/2 the
# shell emitted (a prompt with a long path, an ssh banner), so any fixed size is a size a real title
# can exceed. As a callback with no decoder it is skipped instead, which cannot overflow. This
# matters far beyond adoption: `list` is also the startup liveness probe, so a title nobody reads
# used to be able to stop lite from launching at all.
wagterm.ptyhost.SessionInfo.id       max_size:128
wagterm.ptyhost.SessionInfo.creation_ticket max_size:33
# agliteterm sets 9 (the WAGTERM_* identity, TERM_PROGRAM, the theme pair, COLORTERM); one spare.
# nanopb refuses to encode a count past this, so raise it BEFORE lite adds an entry.
wagterm.ptyhost.Create.env           max_count:10
wagterm.ptyhost.Create.EnvEntry.key    max_size:64
wagterm.ptyhost.Create.EnvEntry.value  max_size:192

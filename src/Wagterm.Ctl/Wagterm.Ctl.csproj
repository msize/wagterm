<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Wagterm.Ctl</RootNamespace>
    <AssemblyName>wagtermctl</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- For running install.* locally (no running app / pipe needed), e.g. from the installer. -->
    <ProjectReference Include="../Wagterm.Pty/Wagterm.Pty.csproj" />
  </ItemGroup>
</Project>
